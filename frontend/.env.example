# Frontend environment — copy to .env.local (never commit it).
# Only NEXT_PUBLIC_* values reach the browser. NEVER put the Supabase service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Used by docker-compose (browser-safe values only; never put the service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Set to 1 to install faster-whisper in the backend image (Speaking Coach microphone transcription).
WITH_STT=0
